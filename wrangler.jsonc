{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "form-pack",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "formpack.app",
      "custom_domain": true
    }
  ]
}
